# =============================================================================
# Auction Price Prediction - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# MaxSold API Configuration
# -----------------------------------------------------------------------------
# Rate limiting settings for scraper
MAXSOLD_RATE_LIMIT=10  # requests per second
MAXSOLD_RETRY_ATTEMPTS=3
MAXSOLD_RETRY_DELAY=1.0  # seconds

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DUCKDB_PATH=data/auction.duckdb
# For read-only mode in production
DUCKDB_READ_ONLY=false

# -----------------------------------------------------------------------------
# Hugging Face Configuration
# -----------------------------------------------------------------------------
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Hugging Face repository names (will be created under your username)
HF_DATASET_REPO=maxsold-auctions
HF_MODEL_REPO=auction-price-predictor
HF_SPACE_REPO=auction-price-predictor

# Optional: Organization name (leave empty for personal account)
HF_ORGANIZATION=

# -----------------------------------------------------------------------------
# Model Training Configuration
# -----------------------------------------------------------------------------
# Device settings
DEVICE=auto  # auto, cpu, cuda, mps
TORCH_DTYPE=float32  # float32, float16, bfloat16

# Training defaults (can be overridden via CLI)
BATCH_SIZE=32
LEARNING_RATE=0.001
NUM_EPOCHS=100
EARLY_STOPPING_PATIENCE=10

# Weights & Biases (optional - for experiment tracking)
WANDB_PROJECT=auction-price-prediction
WANDB_API_KEY=your_wandb_key_here
WANDB_DISABLED=true  # Set to false to enable

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -----------------------------------------------------------------------------
# Gradio Configuration
# -----------------------------------------------------------------------------
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false  # Set to true for public link

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------
# For local development only
RELOAD=true
